#!/bin/bash
# Copyright 2026 Seamware
#
# corTest - Functional test harness
#
# Test file format (.test):
#   --NAME--
#   Human-readable test name
#
#   --INIT--
#   Setup commands (run before test)
#
#   --RUN--
#   Test execution (stdout captured and compared to --EXPECT--)
#
#   --EXPECT--
#   Expected output (supports REGEX() and #SORT_START/#SORT_END)
#
#   --TEARDOWN--
#   Cleanup commands (run after test). The MARKER IS MANDATORY - a test file
#   without it is malformed and is refused before it runs. Leave the section
#   empty when there is genuinely nothing to tear down.
#

# -----------------------------------------------------------------------------
#
# Find script home directory (where corTest lives)
#
dirname=$(dirname $0)
if [ "$dirname" == "" ]; then
  dirname="."
fi
cd $dirname
SCRIPT_HOME=$(pwd)
cd - > /dev/null 2>&1

export SCRIPT_HOME

# -----------------------------------------------------------------------------
#
# Repo root
#
# corTest used to REQUIRE being started from the repo root, and forgetting that
# was the entire reason the coraineTest wrapper existed. It now finds the root
# itself:
#
#   1. the nearest ancestor of $PWD carrying test/funcTests/corTestFunctions.sh
#      (so anywhere inside the repo works), else
#   2. the repo owning the first test path on the command line (so an absolute
#      path works from anywhere at all).
#
# Test paths given relative to the ORIGINAL cwd are resolved to absolute before
# the cd, so they keep pointing at the same file.
#
repoRootOf()
{
  local dir="$1"

  while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do
    if [ -f "$dir/test/funcTests/corTestFunctions.sh" ]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done

  return 1
}

REPO_ROOT=$(repoRootOf "$(pwd)")

if [ "$REPO_ROOT" == "" ]; then
  # Not inside a test repo — try the repo that owns a path argument, and make
  # every existing path argument absolute so it survives the cd below.
  _corArgs=()
  for _a in "$@"; do
    if [ -e "$_a" ]; then
      _a=$(cd "$(dirname "$_a")" >/dev/null 2>&1 && printf '%s/%s' "$(pwd)" "$(basename "$_a")")
      [ "$REPO_ROOT" == "" ] && REPO_ROOT=$(repoRootOf "$(dirname "$_a")")
    fi
    _corArgs+=("$_a")
  done
  set -- "${_corArgs[@]}"
fi

if [ "$REPO_ROOT" == "" ]; then
  echo "corTest: no test repo here — run it inside one (a directory whose"
  echo "        test/funcTests/corTestFunctions.sh exists), or name a test by"
  echo "        absolute path."
  exit 1
fi

cd "$REPO_ROOT"
export REPO_ROOT

# Repo-specific test functions file
# Default: test/funcTests/corTestFunctions.sh (relative to repo root)
# Override: COR_TEST_FUNCTIONS env var
COR_TEST_FUNCTIONS="${COR_TEST_FUNCTIONS:-${REPO_ROOT}/test/funcTests/corTestFunctions.sh}"
export COR_TEST_FUNCTIONS

# Repo-specific CLI parameters file
# Sourced before argument parsing so repos can inject custom options
COR_TEST_PARAMS="${COR_TEST_PARAMS:-${REPO_ROOT}/test/funcTests/corTestParams.sh}"


# -----------------------------------------------------------------------------
#
# Orphan reaping + follow file
#
# Two suites can never coexist (they share the broker port), so a fresh launch
# wins and anything left over from a previous run is reaped here. This is the
# real protection: even a run that was SIGKILLed (its trap never ran) leaves
# orphans that the NEXT run cleans up. The INT/TERM traps take the brokers down
# with us instead of orphaning them.
#
# ftClient is the SAME binary in both stacks, so it is reaped BY PORT RANGE
# (Coraine owns 77xx, fw owns 78xx) — a bare `killall ftClient` here would shoot the
# fw suite's mocks mid-run, and it used to.
#
# /tmp/sTest.out is the "follow any running test" file — truncated per run and
# UNBUFFERED, so `tail -f` shows which test is running as it happens.
#
corTestReap()
{
  # A stale ENGINE from a previous run. Never ourselves or our caller: this
  # script's own command line matches "corTest/corTest", so a bare pkill -f would
  # shoot the run doing the reaping.
  local pid
  for pid in $(pgrep -f "corTest/corTest" 2>/dev/null); do
    [ "$pid" == "$$" ]     && continue
    [ "$pid" == "$PPID" ]  && continue
    kill -9 "$pid" 2>/dev/null
  done

  pkill -9 -f "valgrind.*coraine"      2>/dev/null
  killall -9 coraine                   2>/dev/null
  pkill -9 -f "ftClient.*--port 77"     2>/dev/null
  return 0
}

if [ "$COR_TEST_NO_REAP" != "on" ]; then
  corTestReap
  sleep 0.3   # let the ports release

  trap 'corTestReap; exit 130' INT
  trap 'corTestReap; exit 143' TERM
fi

COR_TEST_FOLLOW="${COR_TEST_FOLLOW:-/tmp/sTest.out}"
if [ "$COR_TEST_FOLLOW" != "off" ]; then
  {
    echo "---------- Cor Test Suite -------"
    echo "corTest $*"
  } > "$COR_TEST_FOLLOW"
  exec > >(stdbuf -o0 tee -a "$COR_TEST_FOLLOW") 2>&1
fi


# -----------------------------------------------------------------------------
#
# Repo-injectable CLI parameters
#
# Arrays indexed in parallel:
#   COR_CLI_PARAM_NAMES[i]    - option name, e.g. "-db"
#   COR_CLI_PARAM_VARS[i]     - variable name, e.g. "COR_DB_TYPE"
#   COR_CLI_PARAM_DEFAULTS[i] - default value, e.g. "ramdb"
#   COR_CLI_PARAM_DESCS[i]    - description for usage output
#   COR_CLI_PARAM_TAGS[i]     - tag for REQUIRE_/SKIP_ markers, e.g. "DB"
#
declare -a COR_CLI_PARAM_NAMES
declare -a COR_CLI_PARAM_VARS
declare -a COR_CLI_PARAM_DEFAULTS
declare -a COR_CLI_PARAM_DESCS
declare -a COR_CLI_PARAM_TAGS

#
# corCliParamAdd - register a custom CLI parameter
#
# $1: option name      (e.g. "-db")
# $2: variable name    (e.g. "COR_DB_TYPE")
# $3: default value    (e.g. "ramdb")
# $4: description      (e.g. "Current-state DB plugin (ramdb|mongoc)")
# $5: applicability/skip tag (e.g. "DB" => test files use REQUIRE_DB: / SKIP_DB:).
#     REQUIRE_ decides whether a test is part of the run at all; SKIP_ skips one
#     that is. Two questions, two mechanisms - see testApplies / shouldSkipTest.
#
function corCliParamAdd()
{
  local ix=${#COR_CLI_PARAM_NAMES[@]}
  COR_CLI_PARAM_NAMES[$ix]="$1"
  COR_CLI_PARAM_VARS[$ix]="$2"
  COR_CLI_PARAM_DEFAULTS[$ix]="$3"
  COR_CLI_PARAM_DESCS[$ix]="$4"
  COR_CLI_PARAM_TAGS[$ix]="$5"
}

# Source repo params file (registers custom CLI options)
if [ -f "$COR_TEST_PARAMS" ]; then
  source "$COR_TEST_PARAMS"
fi

# Apply defaults for all registered params (NONE means "not set")
for ix in "${!COR_CLI_PARAM_NAMES[@]}"; do
  local_var="${COR_CLI_PARAM_VARS[$ix]}"
  local_default="${COR_CLI_PARAM_DEFAULTS[$ix]}"
  if [ "$local_default" == "NONE" ]; then
    eval "export ${local_var}=\"\${${local_var}:-NONE}\""
  else
    eval "export ${local_var}=\"\${${local_var}:-${local_default}}\""
  fi
done


# -----------------------------------------------------------------------------
#
# Logging
#
LOG_FILE=/tmp/corTest.log

function logMsg()
{
  echo "$(date '+%Y-%m-%dT%H:%M:%S') $*" >> $LOG_FILE
}

function vMsg()
{
  if [ "$verbose" == "on" ]; then
    echo "$*"
  fi
}


# -----------------------------------------------------------------------------
#
# usage
#
function usage()
{
  sfile="Usage: $(basename $0)"
  empty=$(echo $sfile | tr 'a-zA-Z/0-9.:' ' ')
  echo "$sfile [-u (usage)]"
  echo "$empty [-v (verbose)]"
  echo "$empty [-g]                           (GUI diff on failure, using corDiffGui)"
  echo "$empty [--filter <pattern>]           (default: *.test)"
  echo "$empty [--match <grep-pattern>]       (filter test names)"
  echo "$empty [--keep]                       (keep output files on success)"
  echo "$empty [--dryrun]                     (list tests, don't run)"
  echo "$empty [--stopOnError]                (stop on first failure)"
  echo "$empty [--maxTries <N>]               (retry failing tests, default: 1)"
  echo "$empty [--regen]                      (fill --EXPECT-- from captured output; needs an empty --EXPECT-- marker)"
  echo "$empty [--diffTool <path>]            (external diff tool on failure)"
  echo "$empty [--noColor]                    (disable colored output)"
  echo "$empty [--fromIx <N>]                 (start from test index N)"
  echo "$empty [--toIx <N>]                   (stop at test index N)"
  echo "$empty [-ix | --ix <spec>]            (run only these 1-based indices, e.g. 5-10,102,201-206)"
  echo "$empty [--skip <spec>]                (run all BUT these indices, same grammar - reported as skipped)"
  echo "$empty [--skipNames <list>]          (skip these test NAMES; default \$CORTEST_SKIP, for a standing list)"
  echo "$empty [--tags <csv>]                 (only run tests whose --TAGS-- intersect)"
  echo "$empty [--skip-tags <csv>]            (run all tests EXCEPT those whose --TAGS-- intersect)"
  echo "$empty [-vt | --vt]                   (run the main broker under valgrind; fail on definite/indirect leaks or errors)"
  echo "$empty [<file.test> | <directory>]... (default: cases/)"

  # Repo-injected parameters
  for ix in "${!COR_CLI_PARAM_NAMES[@]}"; do
    local_name="${COR_CLI_PARAM_NAMES[$ix]}"
    local_desc="${COR_CLI_PARAM_DESCS[$ix]}"
    local_default="${COR_CLI_PARAM_DEFAULTS[$ix]}"
    local_padding=$((28 - ${#local_name} - ${#local_desc}))
    if [ $local_padding -lt 1 ]; then local_padding=1; fi
    if [ "$local_default" == "NONE" ]; then
      printf "%s [%s <%s>]%*s(not set by default)\n" "$empty" "$local_name" "$local_desc" $local_padding ""
    else
      printf "%s [%s <%s>]%*s(default: %s)\n" "$empty" "$local_name" "$local_desc" $local_padding "" "$local_default"
    fi
  done

  # Known tags (collected from --TAGS-- sections of every test in the default
  # cases directory)
  local casesDir="test/funcTests/cases"
  if [ -d "$casesDir" ]; then
    local allTags
    allTags=$(for f in "$casesDir"/*.test; do
      [ -f "$f" ] || continue
      sed -n '/^--TAGS--$/,/^--/p' "$f" | grep -v '^--' | tr ' ' '\n'
    done 2>/dev/null | sort -u | grep -v '^$' | paste -sd' ' -)
    if [ -n "$allTags" ]; then
      echo
      echo "Known tags (pass one or more to --tags):"
      echo "$allTags" | fold -s -w 76 | sed 's/^/  /'
    fi
  fi

  exit $1
}


# -----------------------------------------------------------------------------
#
# Terminal colors
#
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'  # No Color

function colorPass()
{
  if [ "$noColor" == "on" ]; then echo "OK";
  else echo -e "${GREEN}OK${NC}"; fi
}

function colorFail()
{
  if [ "$noColor" == "on" ]; then echo "FAIL: $1";
  else echo -e "${RED}FAIL: $1${NC}"; fi
}

function colorSkip()
{
  if [ "$noColor" == "on" ]; then echo "SKIP";
  else echo -e "${YELLOW}SKIP${NC}"; fi
}


# -----------------------------------------------------------------------------
#
# specHasIx <spec> <n> - does 1-based index <n> fall inside <spec>?
#
# <spec> is a comma-separated list of singletons and lo-hi ranges, e.g.
# "5-10,102,201-206". Shared by -ix (run ONLY these) and --skip (run all but
# these), which take the same grammar from opposite ends.
#
function specHasIx()
{
  local spec="$1" n="$2" part lo hi
  local -a parts
  IFS=',' read -ra parts <<< "$spec"
  for part in "${parts[@]}"; do
    if [[ "$part" == *-* ]]; then
      lo="${part%%-*}"; hi="${part##*-}"
      if [ "$n" -ge "$lo" ] && [ "$n" -le "$hi" ]; then return 0; fi
    elif [ "$n" -eq "$part" ]; then
      return 0
    fi
  done
  return 1
}


# -----------------------------------------------------------------------------
#
# nameInSkipList <testFile> - is this test named in $skipNames?
#
# $skipNames (default: $CORTEST_SKIP, so it can live in a .bashrc) is a list of
# test names separated by whitespace and/or commas. A name is the file name,
# with or without the .test suffix, and with an OPTIONAL single directory level
# in front - the same identifier the runner prints, so an entry can be copied
# straight out of a log:
#
#   export CORTEST_SKIP="troe_timescale_temporal_q_deep cases/subscription_pernot"
#
# Names, not indices: an index list rots the moment a test is added, and this
# one is meant to survive in a shell profile. Shell globs work.
#
function nameInSkipList()
{
  local testFile="$1" entry name dirName display

  [ -z "$skipNames" ] && return 1

  name=$(basename "$testFile" .test)
  dirName=$(basename "$(dirname "$testFile")")
  display="$dirName/$name"

  for entry in ${skipNames//,/ }; do
    entry="${entry%.test}"
    if [[ "$name" == $entry ]] || [[ "$display" == $entry ]]; then
      return 0
    fi
  done

  return 1
}


# -----------------------------------------------------------------------------
#
# reportSkip <testFile> - print the SKIP line for a test and count it
#
# For a test that WAS part of this run and is being passed over: SKIP_<TAG>, or
# the operator's own --skip. $SKIP_REASON says which. Advances $testIx; the
# caller continues the loop.
#
function reportSkip()
{
  local testFile="$1"
  local displayName dirPart parentDir prefix skipMsg textPart textLen dotsNeeded dots

  displayName=$(basename "$testFile" .test)
  dirPart=$(dirname "$testFile")
  parentDir=$(basename "$dirPart")
  if [ "$parentDir" != "." ] && [ "$parentDir" != "/" ]; then
    displayName="${parentDir}/${displayName}"
  fi
  prefix=$(printf "%04d/%d/%d:" $testIx $totalTests $failCount)
  skipMsg=$(colorSkip)
  textPart="$prefix $displayName "
  textLen=${#textPart}
  dotsNeeded=$((DOT_END_COL - textLen))
  if [ $dotsNeeded -lt 3 ]; then dotsNeeded=3; fi
  dots=$(printf '%*s' $dotsNeeded '' | tr ' ' '.')
  printf "%s %s %s  %s (%s)\n" "$prefix" "$displayName" "$dots" "$skipMsg" "$SKIP_REASON"
  skipCount=$((skipCount + 1))
  testIx=$((testIx + 1))
}


# -----------------------------------------------------------------------------
#
# testApplies - does this test case apply to the configuration being run?
#
#   # REQUIRE_<TAG>: val1 val2 ...   (the test only applies when the current
#                                     value of that CLI param is in the list)
#
# Returns 0 if the test applies, 1 if it does not (sets NA_REASON).
#
# NOT the same thing as skipping, and deliberately not the same mechanism: a
# ramdb-only test on a mongoc run was never a candidate to begin with. Nobody
# decided to pass on it, so it is filtered out before the run set is counted -
# it is not part of this run at all, and reporting it as "skipped" would have
# made "580 passed of 585" out of "580 tests, all green".
#
function testApplies()
{
  local testFile="$1"
  NA_REASON=""

  for ix in "${!COR_CLI_PARAM_TAGS[@]}"; do
    local tag="${COR_CLI_PARAM_TAGS[$ix]}"
    if [ -z "$tag" ]; then continue; fi

    local varName="${COR_CLI_PARAM_VARS[$ix]}"
    local currentValue
    eval "currentValue=\"\${$varName}\""

    if [ "$currentValue" == "NONE" ]; then continue; fi

    local requireLine
    requireLine=$(grep "^# *REQUIRE_${tag}:" "$testFile" 2>/dev/null | head -1)
    if [ -n "$requireLine" ]; then
      local values="${requireLine#*:}"
      values=$(echo $values)  # trim whitespace
      local found=false
      for v in $values; do
        if [ "$v" == "$currentValue" ]; then found=true; break; fi
      done
      if [ "$found" != "true" ]; then
        NA_REASON="does not apply to ${tag}=${currentValue}"
        return 1
      fi
    fi
  done

  return 0
}


# -----------------------------------------------------------------------------
#
# shouldSkipTest - check SKIP_<TAG> markers in a test file
#
# For each registered CLI param that has a tag, grep the test file for:
#   # SKIP_<TAG>: val1 val2 ...      (skip if current value is in the list)
#
# Returns 0 if test should be skipped (sets SKIP_REASON), 1 if it should run.
# Applicability (REQUIRE_<TAG>) is a different question - see testApplies.
#
function shouldSkipTest()
{
  local testFile="$1"
  SKIP_REASON=""

  for ix in "${!COR_CLI_PARAM_TAGS[@]}"; do
    local tag="${COR_CLI_PARAM_TAGS[$ix]}"
    if [ -z "$tag" ]; then continue; fi

    local varName="${COR_CLI_PARAM_VARS[$ix]}"
    local currentValue
    eval "currentValue=\"\${$varName}\""

    # Skip check not applicable if param was not set
    if [ "$currentValue" == "NONE" ]; then continue; fi

    # Check SKIP_<TAG>
    local skipLine
    skipLine=$(grep "^# *SKIP_${tag}:" "$testFile" 2>/dev/null | head -1)
    if [ -n "$skipLine" ]; then
      local values="${skipLine#*:}"
      for v in $values; do
        if [ "$v" == "$currentValue" ]; then
          SKIP_REASON="skipped for ${tag}=$currentValue"
          return 0
        fi
      done
    fi
  done

  return 1
}


# -----------------------------------------------------------------------------
#
# extractSection - extract a section from a .test file
#
# $1: section name (e.g. "NAME", "INIT", "RUN", "EXPECT", "TEARDOWN")
# $2: path to .test file
#
function extractSection()
{
  local section="$1"
  local file="$2"

  sed -n "/^--${section}--$/,/^--/p" "$file" | grep -v "^--"
}


# -----------------------------------------------------------------------------
#
# tagsFilterMatches - return 0 if the test should run given $tagsFilter
#
# $1: path to .test file
#
# Returns 0 if the filter is empty (no filtering) or if any tag in the
# test's --TAGS-- section is in $tagsFilter (comma-separated). Returns
# 1 if the test has no --TAGS-- section or no intersecting tag.
#
function tagsFilterMatches()
{
  [ -z "$tagsFilter" ] && [ -z "$skipTagsFilter" ] && return 0

  local testFile="$1"
  local testTags
  testTags=$(extractSection "TAGS" "$testFile")

  # --skip-tags: drop any test whose tags intersect the skip set.
  # A test with no --TAGS-- section is never skipped by --skip-tags.
  if [ -n "$skipTagsFilter" ]; then
    local unwanted
    IFS=',' read -ra unwanted <<< "$skipTagsFilter"
    for w in "${unwanted[@]}"; do
      w="${w// /}"
      [ -z "$w" ] && continue
      for t in $testTags; do
        if [ "$t" == "$w" ]; then return 1; fi
      done
    done
    [ -z "$tagsFilter" ] && return 0
  fi

  [ -z "$testTags" ] && return 1

  local wanted
  IFS=',' read -ra wanted <<< "$tagsFilter"
  for w in "${wanted[@]}"; do
    w="${w// /}"
    [ -z "$w" ] && continue
    for t in $testTags; do
      if [ "$t" == "$w" ]; then return 0; fi
    done
  done
  return 1
}


# -----------------------------------------------------------------------------
#
# fileCreation - extract all sections from a .test file
#
function fileCreation()
{
  local testFile="$1"
  local dir=$(dirname "$testFile")
  local base=$(basename "$testFile" .test)
  local prefix="$dir/$base"

  extractSection "NAME" "$testFile" > "$prefix.name"
  NAME=$(cat "$prefix.name")

  if [ ! -s "$prefix.name" ]; then
    echo "Error: --NAME-- section missing or empty in $testFile"
    return 2
  fi

  extractSection "INIT"     "$testFile" > "$prefix.init"
  extractSection "RUN"      "$testFile" > "$prefix.run"
  extractSection "EXPECT"   "$testFile" > "$prefix.expect"
  extractSection "TEARDOWN" "$testFile" > "$prefix.teardown"

  # RUN and EXPECT are mandatory
  if [ ! -s "$prefix.run" ]; then
    echo "Error: --RUN-- section missing or empty in $testFile"
    return 4
  fi

  # In --regen mode the EXPECT is (re)generated from the captured output, so an
  # empty --EXPECT-- block is expected — only the marker itself must be present
  # (corRegenExpect anchors on it). Otherwise EXPECT is mandatory.
  if [ ! -s "$prefix.expect" ] && [ "$regen" != "on" ]; then
    echo "Error: --EXPECT-- section missing or empty in $testFile"
    return 5
  fi

  if [ "$regen" == "on" ] && ! grep -q '^--EXPECT--$' "$testFile"; then
    echo "Error: --regen needs an (empty) --EXPECT-- marker in $testFile"
    return 5
  fi

  #
  # The --TEARDOWN-- MARKER is mandatory, its content is not. A test that leaves
  # something running (a broker, a client, a database) and never says so does not
  # just fail itself - it leaks that state into every test after it, where the
  # damage shows up as somebody else's flake. Requiring the marker makes "nothing
  # to tear down" a deliberate, visible statement instead of an omission.
  #
  # This also catches a malformed file produced by --regen: an EXPECT block that
  # swallowed the sections below it.
  #
  if ! grep -q '^--TEARDOWN--$' "$testFile"; then
    echo "Error: --TEARDOWN-- section missing in $testFile (the marker is mandatory; leave it empty if there is nothing to tear down)"
    return 6
  fi

  # Make shell scripts executable
  chmod 755 "$prefix.init"     2>/dev/null
  chmod 755 "$prefix.run"      2>/dev/null
  chmod 755 "$prefix.teardown" 2>/dev/null

  return 0
}


# -----------------------------------------------------------------------------
#
# fileCleanup - remove generated files for a test
#
function fileCleanup()
{
  local testFile="$1"
  local dir=$(dirname "$testFile")
  local base=$(basename "$testFile" .test)
  local prefix="$dir/$base"

  rm -f "$prefix.name"
  rm -f "$prefix.init"
  rm -f "$prefix.run"
  rm -f "$prefix.expect"
  rm -f "$prefix.teardown"
  rm -f "$prefix.out"
  rm -f "$prefix.diff"
  rm -f "$prefix.init.stderr"
  rm -f "$prefix.run.stderr"
  rm -f "$prefix.teardown.stderr"
  rm -f "$prefix.expect.sorted"
  rm -f "$prefix.out.sorted"

  # Valgrind logs (--vt) live in /tmp, keyed on the test base name. Like the
  # other artifacts they are removed on PASS and kept on FAIL — so a leftover
  # /tmp/corValgrind.<test>.*.vg marks a test that leaked, just as a leftover
  # .diff marks one that mismatched.
  rm -f "/tmp/corValgrind.$base".*.vg
}


# -----------------------------------------------------------------------------
#
# runTest - run a single test
#
# Returns:
#   0  - pass
#   6  - malformed test file (no --TEARDOWN-- section)
#   7  - RUN stderr not empty
#   8  - RUN non-zero exit
#   9  - output mismatch
#   10 - INIT stderr not empty
#   11 - INIT non-zero exit
#   12 - TEARDOWN error
#
function runTest()
{
  local testFile="$1"
  local tryNo="$2"
  local dir=$(dirname "$testFile")
  local base=$(basename "$testFile" .test)
  local prefix="$dir/$base"

  # --- File creation (extract sections) ---
  fileCreation "$testFile"
  local fRes=$?
  if [ "$fRes" != 0 ]; then
    return $fRes
  fi

  # --- Source helper functions into generated scripts ---
  # Line 2: corTest's own helper functions (corCurl, coraineStart, etc.)
  # Line 3: repo-specific functions (coraineTestInit.sh or equivalent)
  local srcLine="source $SCRIPT_HOME/corTestFunctions.sh"
  local repoSrcLine=""
  if [ -f "$COR_TEST_FUNCTIONS" ]; then
    repoSrcLine="source $COR_TEST_FUNCTIONS"
  fi
  for part in init run teardown; do
    if [ -s "$prefix.$part" ]; then
      head -1 "$prefix.$part" | grep -q '^#!' || sed -i '1i#!/bin/bash' "$prefix.$part"
      # Insert source lines after the shebang
      if [ -n "$repoSrcLine" ]; then
        sed -i "2i$repoSrcLine" "$prefix.$part"
      fi
      sed -i "2i$srcLine" "$prefix.$part"
    fi
  done

  # --- INIT ---
  if [ -s "$prefix.init" ]; then
    vMsg "  Running INIT ..."
    logMsg "INIT: $testFile"

    bash "$prefix.init" > /dev/null 2> "$prefix.init.stderr"
    local initExit=$?

    if [ -s "$prefix.init.stderr" ]; then
      echo "  INIT produced stderr:"
      cat "$prefix.init.stderr" | head -5
      return 10
    fi

    if [ "$initExit" != 0 ]; then
      echo "  INIT exited with code $initExit"
      return 11
    fi
  fi

  # --- RUN ---
  vMsg "  Running RUN ..."
  logMsg "RUN: $testFile"

  bash "$prefix.run" > "$prefix.out" 2> "$prefix.run.stderr"
  local runExit=$?

  # TEARDOWN must always run once INIT succeeded, regardless of whether
  # RUN or the output diff failed — otherwise a failed test leaves the
  # broker running, the mongo DB populated, and subsequent tests see
  # stale state.
  local rc=0

  if [ -s "$prefix.run.stderr" ]; then
    echo "  RUN produced stderr:"
    cat "$prefix.run.stderr" | head -5
    rc=7
  elif [ "$runExit" != 0 ]; then
    echo "  RUN exited with code $runExit"
    rc=8
  elif [ "$regen" == "on" ]; then
    # Author mode: fill the --EXPECT-- block from the just-captured output.
    # Prefer a repo-provided regen tool (which can apply program-specific
    # volatility transforms — timestamps, ids, etc.); fall back to corTest's
    # generic verbatim fill. Override the path via COR_REGEN_TOOL.
    vMsg "  Regenerating EXPECT ..."
    regenTool="${COR_REGEN_TOOL:-${REPO_ROOT}/test/funcTests/tools/corRegenExpect}"
    [ -x "$regenTool" ] || regenTool="$SCRIPT_HOME/corRegenExpect"
    "$regenTool" "$base"
  else
    vMsg "  Comparing output ..."
    $SCRIPT_HOME/corDiff -r "$prefix.expect" -i "$prefix.out" > "$prefix.diff" 2>&1
    if [ "$?" != 0 ]; then
      vMsg "  Output mismatch"
      rc=9
    fi
  fi

  # --- TEARDOWN (always, so broker + DB state don't leak to next tests) ---
  if [ -s "$prefix.teardown" ]; then
    vMsg "  Running TEARDOWN ..."
    logMsg "TEARDOWN: $testFile"

    bash "$prefix.teardown" > /dev/null 2> "$prefix.teardown.stderr"
    local teardownExit=$?

    if [ "$teardownExit" != 0 ]; then
      echo "  TEARDOWN exited with code $teardownExit"
      # Only promote to TEARDOWN error if the test itself was OK;
      # otherwise the test's own failure is the primary signal.
      [ $rc -eq 0 ] && rc=12
    fi
  fi

  return $rc
}


# -----------------------------------------------------------------------------
#
# Argument parsing
#
verbose=off
testFilter="*.test"
matchPattern=""
keepFiles=off
dryRun=off
stopOnError=off
maxTries=1
diffTool=""
noColor=off
regen=off
fromIx=0
toIx=0
ixSpec=""
skipSpec=""
skipNames="$CORTEST_SKIP"      # standing skip list, by name - see nameInSkipList
tagsFilter=""
skipTagsFilter=""
valgrind=off
declare -a fileArgs

while [ "$#" != 0 ]
do
  if   [ "$1" == "-u" ];            then usage 0;
  elif [ "$1" == "-v" ];            then verbose=on;
  elif [ "$1" == "--filter" ];      then testFilter="$2"; shift;
  elif [ "$1" == "--match" ];       then matchPattern="$2"; shift;
  elif [ "$1" == "--keep" ];        then keepFiles=on;
  elif [ "$1" == "--dryrun" ];      then dryRun=on;
  elif [ "$1" == "--stopOnError" ]; then stopOnError=on;
  elif [ "$1" == "--maxTries" ];    then maxTries="$2"; shift;
  elif [ "$1" == "--regen" ];       then regen=on;
  elif [ "$1" == "-g" ];            then diffTool="$SCRIPT_HOME/corDiffGui";
  elif [ "$1" == "--diffTool" ];    then diffTool="$2"; shift;
  elif [ "$1" == "--noColor" ];     then noColor=on;
  elif [ "$1" == "--fromIx" ];      then fromIx="$2"; shift;
  elif [ "$1" == "--toIx" ];        then toIx="$2"; shift;
  elif [ "$1" == "-ix" ] || [ "$1" == "--ix" ]; then ixSpec="$2"; shift;
  elif [ "$1" == "--skip" ];                        then skipSpec="$2"; shift;
  elif [ "$1" == "--skipNames" ];                   then skipNames="$2"; shift;
  elif [ "$1" == "--tags" ];        then tagsFilter="$2"; shift;
  elif [ "$1" == "--skip-tags" ];   then skipTagsFilter="$2"; shift;
  elif [ "$1" == "-vt" ] || [ "$1" == "--vt" ]; then valgrind=on; export COR_VALGRIND=1;
  elif [ -f "$1" ] || [ -d "$1" ]; then fileArgs+=("$1");
  elif [ -f "test/funcTests/cases/$1" ]; then fileArgs+=("test/funcTests/cases/$1");
  elif [ -f "test/funcTests/cases/$1.test" ]; then fileArgs+=("test/funcTests/cases/$1.test");
  else
    # Check repo-injected parameters
    matched=false
    for ix in "${!COR_CLI_PARAM_NAMES[@]}"; do
      if [ "$1" == "${COR_CLI_PARAM_NAMES[$ix]}" ]; then
        eval "export ${COR_CLI_PARAM_VARS[$ix]}=\"$2\""
        shift
        matched=true
        break
      fi
    done

    if [ "$matched" != "true" ]; then
      echo "$(basename $0): bad parameter/option: '${1}'"
      echo
      usage 1
    fi
  fi
  shift
done


# -----------------------------------------------------------------------------
#
# Build test file list from arguments (files and/or directories)
# Default to cases/ if no file arguments given
#
if [ ${#fileArgs[@]} == 0 ]; then
  fileArgs=("test/funcTests/cases")
fi

testFiles=""
for arg in "${fileArgs[@]}"; do
  if [ -f "$arg" ]; then
    testFiles="$testFiles $arg"
  elif [ -d "$arg" ]; then
    dirFiles=$(find "$arg" -name "$testFilter" | sort)
    testFiles="$testFiles $dirFiles"
  fi
done

# Trim leading space and sort
testFiles=$(echo "$testFiles" | tr ' ' '\n' | sed '/^$/d' | sort)

if [ "$matchPattern" != "" ]; then
  testFiles=$(echo "$testFiles" | grep "$matchPattern")
fi

# Apply --tags / --skip-tags filter here (before totalTests is counted) so
# index/total reflect the filtered subset — e.g. "0005/35/0" not "0164/177/0".
if [ -n "$tagsFilter" ] || [ -n "$skipTagsFilter" ]; then
  filtered=""
  for tf in $testFiles; do
    if tagsFilterMatches "$tf"; then
      filtered="$filtered$tf"$'\n'
    fi
  done
  testFiles=$(echo "$filtered" | sed '/^$/d')
fi

# Drop the test cases that do not apply to this configuration (REQUIRE_<TAG>),
# here, before totalTests is counted. They are not part of this run - counting
# them and then reporting them as "skipped" would understate a clean run.
# Silently - a test that does not apply to this configuration is not news.
naFiltered=""
for tf in $testFiles; do
  if testApplies "$tf"; then
    naFiltered="$naFiltered$tf"$'\n'
  fi
done
testFiles=$(echo "$naFiltered" | sed '/^$/d')

totalTests=$(echo "$testFiles" | grep -c '.')

if [ "$totalTests" == 0 ]; then
  echo "No test files found"
  exit 0
fi


# -----------------------------------------------------------------------------
#
# Dry run: just list tests
#
if [ "$dryRun" == "on" ]; then
  # Apply --tags and -ix filters in dryrun mode too so the listing matches what
  # a real run would actually execute. The printed number is the true run index,
  # so -ix values can be copied straight from a plain (unfiltered) listing.
  declare -a dryFiles dryIx
  ix=1
  for testFile in $testFiles; do
    if tagsFilterMatches "$testFile"; then
      if [ -z "$ixSpec" ] || specHasIx "$ixSpec" "$ix"; then
        dryFiles+=("$testFile")
        dryIx+=("$ix")
      fi
      ix=$((ix + 1))
    fi
  done
  echo "Found ${#dryFiles[@]} test(s)"
  if [ "$verbose" == "on" ]; then
    for i in "${!dryFiles[@]}"; do
      name=$(extractSection "NAME" "${dryFiles[$i]}")
      printf "  %3d. %-60s %s\n" "${dryIx[$i]}" "${dryFiles[$i]}" "$name"
    done
  fi
  exit 0
fi


# -----------------------------------------------------------------------------
#
# Main loop
#
logMsg "=== corTest starting: $totalTests tests ==="

# Column where the dots end (same for PASS, FAIL, SKIP).
# The status suffix (time / "SKIP (reason)" / "FAIL: ...") comes after.
DOT_END_COL=90

declare -a failedTests
declare -a failedReasons
passCount=0
failCount=0
skipCount=0
vgLeakCount=0    # --vt: # test cases with a definite/indirect leak
vgErrorCount=0   # --vt: # test cases with a valgrind memory error
testIx=1
suiteStartMs=$(( $(date +%s%N) / 1000000 ))

for testFile in $testFiles; do
  # Index filtering
  if [ "$fromIx" != 0 ] && [ $testIx -lt $fromIx ]; then
    testIx=$((testIx + 1))
    continue
  fi
  if [ "$toIx" != 0 ] && [ $testIx -gt $toIx ]; then
    testIx=$((testIx + 1))
    continue
  fi
  # -ix: run only the listed 1-based indices (comma-separated ranges/singletons)
  if [ -n "$ixSpec" ] && ! specHasIx "$ixSpec" "$testIx"; then
    testIx=$((testIx + 1))
    continue
  fi

  #
  # --skip: the operator deliberately leaving out tests that DO apply and WOULD
  # otherwise run. That is a decision about this run, and a run that left 19
  # cases out must say so - most of all in a log somebody reads later. Reported
  # and counted as skipped, unlike -ix/--match/--tags, which SELECT what the run
  # is about, and unlike REQUIRE_, where there was never anything to leave out.
  #
  if [ -n "$skipSpec" ] && specHasIx "$skipSpec" "$testIx"; then
    SKIP_REASON="--skip $skipSpec"
    reportSkip "$testFile"
    continue
  fi

  # The operator's standing skip list, by name (CORTEST_SKIP / --skipNames).
  # Same decision as --skip, just a lasting one, so it reports the same way.
  if nameInSkipList "$testFile"; then
    SKIP_REASON="skip list"
    reportSkip "$testFile"
    continue
  fi

  # --tags filtering is applied up front (before totalTests is counted)

  # SKIP_<TAG>: the test applies, but is skipped for this parameter value
  if shouldSkipTest "$testFile"; then
    reportSkip "$testFile"
    continue
  fi

  startTime=$(( $(date +%s%N) / 1000000 ))

  # Valgrind (--vt): per-test log base, consumed by coraineStart for the CB
  # (--log-file=<base>.<pid>.vg). Clear any stale logs from a previous run.
  if [ "$valgrind" == "on" ]; then
    export COR_VALGRIND_LOG="/tmp/corValgrind.$(basename "$testFile" .test)"
    \rm -f "${COR_VALGRIND_LOG}".*.vg 2>/dev/null
  fi

  # Print the index / name / dots NOW (no trailing newline) so live output
  # (tail -f /tmp/sTest.out or the terminal) shows WHICH test is currently
  # executing. The timing and PASS/FAIL result are appended to the same line
  # when the test finishes. The E/L/F tally shown is "so far, before this test".
  displayName=$(basename "$testFile" .test)
  dirPart=$(dirname "$testFile")
  parentDir=$(basename "$dirPart")
  if [ "$parentDir" != "." ] && [ "$parentDir" != "/" ]; then
    displayName="${parentDir}/${displayName}"
  fi
  if [ "$valgrind" == "on" ]; then
    prefix=$(printf "%04d/%d (E:%d L:%d F:%d):" $testIx $totalTests $vgErrorCount $vgLeakCount $failCount)
  else
    prefix=$(printf "%04d/%d/%d:" $testIx $totalTests $failCount)
  fi
  textPart="$prefix $displayName "
  textLen=${#textPart}
  dotsNeeded=$((DOT_END_COL - textLen))
  if [ $dotsNeeded -lt 3 ]; then dotsNeeded=3; fi
  dots=$(printf '%*s' $dotsNeeded '' | tr ' ' '.')
  printf "%s %s %s  " "$prefix" "$displayName" "$dots"

  # Retry loop
  result=1
  for tryNo in $(seq 1 $maxTries); do
    runTest "$testFile" "$tryNo"
    result=$?

    if [ "$result" == 0 ]; then
      break
    fi

    if [ "$tryNo" != "$maxTries" ]; then
      vMsg "  Retry $((tryNo + 1))/$maxTries ..."
    fi
  done

  # Valgrind verdict (--vt). Only meaningful when the test PASSED functionally:
  # a functional failure (or crash) makes the leak/error report unreliable, so we
  # leave such a test as its functional failure and do NOT trust its .vg.
  #
  # For a functionally-passing test that started the CB:
  #   - the report MUST be complete (HEAP SUMMARY + ERROR SUMMARY present) — a
  #     truncated .vg (broker killed before valgrind finished) is a HARD FAIL,
  #     never a silent pass (code 14);
  #   - L (leak)  = definite+indirect lost bytes > 0;
  #   - E (error) = ERROR SUMMARY count > 0 (errors-for-leak-kinds=none ⇒ pure
  #     memory errors); cross-checked against Invalid/uninitialised headers;
  #   - possibly-lost is recorded for display but never fails the gate.
  vgLostBytes=0; vgErrCtx=0; vgPossiblyBytes=0
  if [ "$valgrind" == "on" ] && [ "$result" == 0 ]; then
    vgFiles=( "${COR_VALGRIND_LOG}".*.vg )
    if [ -e "${vgFiles[0]}" ]; then
      # Completeness: every .vg must carry both summaries.
      vgComplete=yes
      for vf in "${vgFiles[@]}"; do
        grep -qE "HEAP SUMMARY" "$vf" 2>/dev/null && grep -qE "ERROR SUMMARY" "$vf" 2>/dev/null || vgComplete=no
      done

      if [ "$vgComplete" != "yes" ]; then
        result=14   # truncated/incomplete report — cannot trust
      else
        vgLostBytes=$(grep -hE "(definitely|indirectly) lost:" "${vgFiles[@]}" 2>/dev/null \
                      | sed -E 's/.*lost: ([0-9,]+) bytes.*/\1/' | tr -d ',' | awk '{s+=$1} END{print s+0}')
        vgPossiblyBytes=$(grep -hE "possibly lost:" "${vgFiles[@]}" 2>/dev/null \
                      | sed -E 's/.*lost: ([0-9,]+) bytes.*/\1/' | tr -d ',' | awk '{s+=$1} END{print s+0}')
        vgErrCtx=$(grep -hoE "ERROR SUMMARY: [0-9]+" "${vgFiles[@]}" 2>/dev/null \
                      | awk '{s+=$3} END{print s+0}')
        # cross-check: real memory-error headers should agree with a non-zero count
        vgErrHdr=$(grep -hcE "Invalid (read|write|free)|uninitialised|Mismatched free|Source and destination overlap" "${vgFiles[@]}" 2>/dev/null | awk '{s+=$1} END{print s+0}')
        if [ "$vgErrCtx" -eq 0 ] && [ "$vgErrHdr" -gt 0 ]; then vgErrCtx=$vgErrHdr; fi

        if [ "$vgLostBytes" -gt 0 ]; then vgLeakCount=$((vgLeakCount + 1)); fi
        if [ "$vgErrCtx"   -gt 0 ]; then vgErrorCount=$((vgErrorCount + 1)); fi
        if [ "$vgLostBytes" -gt 0 ] || [ "$vgErrCtx" -gt 0 ]; then result=13; fi
      fi
    fi
  fi

  endTime=$(( $(date +%s%N) / 1000000 ))
  durationMs=$((endTime - startTime))
  durationSec=$((durationMs / 1000))
  durationFrac=$((durationMs % 1000))

  # prefix / displayName / dots were already printed (no trailing newline)
  # before the test ran; here we only append the timing / result to that line.
  suffix=$(printf "%d.%03ds" $durationSec $durationFrac)

  if [ "$result" == 0 ]; then
    # --- PASS ---
    # NB: possibly-lost (the constant ~28KB kalloc-arena baseline) is intentionally
    # NOT shown — it's identical on every line and not actionable. It still never
    # fails the gate (only definite/indirect leaks do).
    printf "%s\n" "$suffix"
    passCount=$((passCount + 1))

    if [ "$keepFiles" != "on" ]; then
      fileCleanup "$testFile"
    fi
  else
    # --- FAIL ---
    local_dir=$(dirname "$testFile")
    local_base=$(basename "$testFile" .test)
    local_prefix="$local_dir/$local_base"

    case $result in
      6)  errorText="malformed test file: no --TEARDOWN-- section" ;;
      7)  errorText="RUN: stderr not empty" ;;
      8)  errorText="RUN: non-zero exit" ;;
      9)  errorText="output mismatch" ;;
      10) errorText="INIT: stderr not empty" ;;
      11) errorText="INIT: non-zero exit" ;;
      12) errorText="TEARDOWN error" ;;
      13) errorText=$(printf "valgrind: L=%d E=%d" "${vgLostBytes:-0}" "${vgErrCtx:-0}")
          errorText="$errorText (see ${COR_VALGRIND_LOG}.*.vg)" ;;
      14) errorText="valgrind: report INCOMPLETE — broker killed before finish, cannot trust" ;;
      *)  errorText="error code $result" ;;
    esac

    if [ "$noColor" == "on" ]; then
      printf "FAIL: %s (%d.%03ds)\n" "$errorText" $durationSec $durationFrac
    else
      printf "${RED}FAIL: %s${NC} (%d.%03ds)\n" "$errorText" $durationSec $durationFrac
    fi

    failCount=$((failCount + 1))
    failedTests+=("$testFile")
    failedReasons+=("$errorText")

    # Snapshot broker log files (one per role) alongside the test
    # artifacts. coraineStart writes to /tmp/coraine.<role>.log;
    # the next test's brokerStart would clobber them.
    # (This block runs at script top level, not in a function, so `local` is
    #  illegal here — _log/_role are plain loop temporaries.)
    for _log in /tmp/coraine.*.log; do
      [ -f "$_log" ] || continue
      _role=$(basename "$_log" .log | sed 's/^coraine\.//')
      cp "$_log" "$local_prefix.$_role.log"
    done

    if [ "$result" == 9 ] && [ "$diffTool" != "" ]; then
      $diffTool -r "$local_prefix.expect" -i "$local_prefix.out"
    fi

    local_teardown="$local_prefix.teardown"
    if [ -s "$local_teardown" ]; then
      bash "$local_teardown" > /dev/null 2>&1
    fi

    if [ "$stopOnError" == "on" ]; then
      echo ""
      echo "Stopping on first error (--stopOnError)"
      break
    fi
  fi

  testIx=$((testIx + 1))
done


# -----------------------------------------------------------------------------
#
# Summary
#
total=$((passCount + failCount + skipCount))

suiteEndMs=$(( $(date +%s%N) / 1000000 ))
suiteMs=$((suiteEndMs - suiteStartMs))
suiteSec=$((suiteMs / 1000))
suiteFrac=$(((suiteMs % 1000) / 100))
timeSuffix=$(printf ", in %d.%d seconds" $suiteSec $suiteFrac)

skipSuffix=""
if [ "$skipCount" != 0 ]; then
  if [ "$noColor" == "on" ]; then
    skipSuffix=", $skipCount skipped"
  else
    skipSuffix=", ${YELLOW}$skipCount skipped${NC}"
  fi
fi

if [ "$failCount" == 0 ]; then
  echo ""
  if [ "$noColor" == "on" ]; then
    echo "$total tests: $passCount passed${skipSuffix}${timeSuffix}"
  else
    echo -e "$total tests: ${GREEN}$passCount passed${NC}${skipSuffix}${timeSuffix}"
  fi
else
  echo ""
  echo "Failed tests:"
  for i in "${!failedTests[@]}"; do
    echo "  ${failedTests[$i]}: ${failedReasons[$i]}"
  done
  echo ""
  if [ "$noColor" == "on" ]; then
    echo "$total tests: $passCount passed, $failCount failed${skipSuffix}${timeSuffix}"
  else
    echo -e "$total tests: ${GREEN}$passCount passed${NC}, ${RED}$failCount failed${NC}${skipSuffix}${timeSuffix}"
  fi
  logMsg "=== corTest finished: $failCount FAILURES ==="
  exit 1
fi

logMsg "=== corTest finished: all tests passed ==="
exit 0
